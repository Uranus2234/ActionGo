+#!/usr/bin/env python3
+import argparse
+from contextlib import nullcontext
+import importlib.util
+import json
+import math
+import os
+from pathlib import Path
+import shlex
+import subprocess
+import sys
+import threading
+import time
+from types import SimpleNamespace
+
+os.environ.setdefault("MUJOCO_GL", "egl")
+
+import mujoco
+import numpy as np
+
+
+def main():
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--actiongo-root", type=Path, default=Path(__file__).resolve().parents[2] / "action_go")
+    parser.add_argument("--duration", type=float, default=100)
+    parser.add_argument("--headless", action="store_true")
+    parser.add_argument("--gantry", action="store_true")
+    parser.add_argument("--terrain", default="terrain-load-step")
+    parser.add_argument("--stop-depth-at", type=float, default=0)
+    parser.add_argument("--stop-torso-imu-at", type=float, default=0)
+    parser.add_argument("--forward-command", type=int, default=6)
+    parser.add_argument("--depth-hz", type=float, default=10)
+    parser.add_argument("--depth-latency-frames", type=int, default=0)
+    parser.add_argument("--finish-x", type=float)
+    parser.add_argument("--official-reference", action="store_true")
+    parser.add_argument("--depth-backend", choices=("mujoco", "training"), default="mujoco")
+    parser.add_argument("--joint-position-limits", action="store_true")
+    parser.add_argument("--depth-check-only", action="store_true")
+    parser.add_argument("--follow-course", action=argparse.BooleanOptionalAction, default=True)
+    parser.add_argument("--require-course-pass", action=argparse.BooleanOptionalAction, default=True)
+    parser.add_argument("--output", type=Path, default=Path(__file__).resolve().parents[1] / "outputs/actiongo_php")
+    args = parser.parse_args()
+    if args.finish_x is None:
+        args.finish_x = 62 if args.terrain == "terrain-load-step" else 0
+    args.output.mkdir(parents=True, exist_ok=True)
+    root = args.actiongo_root.resolve()
+    reference = None
+    if args.official_reference:
+        sys.path.insert(0, str(Path(__file__).resolve().parents[1] / "thirdparty/holosoma/src/holosoma_inference"))
+        from compare_actiongo_php import official_policy
+        from holosoma_inference.policies.base import BasePolicy
+
+        reference, reference_config = official_policy(root, Path(__file__).resolve().parents[1] / "outputs/php_official_inference_config.json")
+        reference.use_policy_action = True
+        reference.get_ready_state = False
+        reference.joint_offsets = np.zeros(29)
+        reference.cmd_q = np.zeros(29)
+        reference.cmd_dq = np.zeros(29)
+        reference.cmd_tau = np.zeros(29)
+        reference.latency_tracker = SimpleNamespace(measure=lambda name: nullcontext())
+    spec = importlib.util.spec_from_file_location("actiongo_sim", root / "tools/sim/action_go_sim_remote.py")
+    remote = importlib.util.module_from_spec(spec)
+    sys.modules[spec.name] = remote
+    spec.loader.exec_module(remote)
+
+    from holosoma.config_types.run_sim import RunSimConfig
+    from holosoma.simulator.base_simulator.hooks import Phase
+    from holosoma.utils.config_registry import parse_config
+    from holosoma.utils.sim_utils import DirectSimulation, setup_simulation_environment
+    from unitree_sdk2py.core.channel import ChannelFactoryInitialize, ChannelPublisher
+    from unitree_sdk2py.idl.default import unitree_hg_msg_dds__IMUState_
+    from unitree_sdk2py.idl.unitree_hg.msg.dds_ import IMUState_
+
+    config = parse_config(RunSimConfig, args=[
+        "robot:g1-29dof", "sensor.d435i_front_depth:g1-d435i-front-depth",
+        "plugin.depth:depth-shm-d435i", "terrain:" + args.terrain,
+        "--robot.asset.xml-file=g1/g1_29dof_halfspherehand.xml",
+        "--simulator.config.bridge.enabled=False", "--simulator.config.sim.fps=500",
+        "--training.headless=" + str(args.headless), "--device=cpu",
+        "--plugin.depth.render-hz=" + str(args.depth_hz),
+        "--plugin.depth.latency-frames=" + str(args.depth_latency_frames),
+    ])
+    env, device, app = setup_simulation_environment(config, device="cpu")
+    ChannelFactoryInitialize(0, "lo")
+    sim_args = remote.parse_args(["--interface", "lo", "--no-use-joystick"])
+    actions = remote.load_action_registry(root / "config/motion_actions.yaml", "lo")
+    command_file = args.output / "command.txt"
+    command_file.write_text("0\n")
+    def write_command(command):
+        temporary = command_file.with_suffix(".tmp")
+        temporary.write_text(str(command) + "\n")
+        temporary.replace(command_file)
+    action = actions["php_locomotion"]
+    action.command += " --spec " + shlex.quote(str(root / "actions/php/config/generic_php_sim.yaml"))
+    if args.joint_position_limits:
+        action.command += " --command-limit-source joint_position"
+    action.command += " --command-source fixed --command-file " + shlex.quote(str(command_file))
+    action.command += " --event-log " + shlex.quote(str(args.output / "runtime.jsonl"))
+    action.command += " --trace-file " + shlex.quote(str(args.output / "trace.yaml"))
+    telemetry = []
+    depth_records = []
+    video = None
+    renderer = None
+    manager = None
+    worker = None
+    with DirectSimulation(config, env, device, app) as direct:
+        sim = direct.simulator
+        model, data = sim.root_model, sim.root_data
+        if args.depth_check_only:
+            from php_depth_reference import compare_depth
+            compare_depth(sim, args.output)
+            return
+        if args.depth_backend == "training":
+            from php_depth_reference import install_training_depth
+            install_training_depth(sim)
+        sim.virtual_gantry.set_enable(args.gantry)
+        data.xfrc_applied[:] = 0
+        bridge = remote.NativeActionGoBridge(model, data)
+        torso_id = mujoco.mj_name2id(model, mujoco.mjtObj.mjOBJ_BODY, "robot_torso_link")
+        torso_publisher = ChannelPublisher("rt/secondary_imu", IMUState_)
+        torso_publisher.Init()
+        torso_imu = unitree_hg_msg_dds__IMUState_()
+        obstacles = []
+        for geom_id in range(model.ngeom):
+            name = mujoco.mj_id2name(model, mujoco.mjtObj.mjOBJ_GEOM, geom_id) or ""
+            if not (name == "floor" or name.startswith("floor_")):
+                continue
+            mesh_id = model.geom_dataid[geom_id]
+            if mesh_id < 0:
+                continue
+            address, count = model.mesh_vertadr[mesh_id], model.mesh_vertnum[mesh_id]
+            vertices = model.mesh_vert[address:address + count] @ data.geom_xmat[geom_id].reshape(3, 3).T + data.geom_xpos[geom_id]
+            lower, upper = vertices.min(axis=0), vertices.max(axis=0)
+            if upper[2] > 0.1 and lower[2] >= -0.01:
+                obstacles.append({"geom_id": geom_id, "name": name, "lower": lower.tolist(),
+                                  "upper": upper.tolist(), "foot_on_top": False,
+                                  "entered": False, "exited": False})
+        obstacles.sort(key=lambda item: item["lower"][0])
+        manager = remote.SimActionManager(sim_args, actions, bridge)
+        model.vis.global_.offwidth = 960
+        model.vis.global_.offheight = 540
+        renderer = mujoco.Renderer(model, height=540, width=960)
+        camera = mujoco.MjvCamera()
+        camera.distance, camera.azimuth, camera.elevation = 3.5, 135, -15
+        video = subprocess.Popen([
+            "ffmpeg", "-y", "-loglevel", "error", "-f", "rawvideo", "-pix_fmt", "rgb24",
+            "-s", "960x540", "-r", "25", "-i", "-", "-an", "-c:v", "libx264",
+            "-preset", "fast", "-pix_fmt", "yuv420p", str(args.output / "simulation.mp4"),
+        ], stdin=subprocess.PIPE)
+        started = released = stopped_command = switched_back = depth_stopped = False
+        handoff_seen = False
+        exit_results = []
+        start = time.monotonic()
+        next_step = start
+        step = 0
+        reference_started_at = None
+        reference_start_q = None
+        decimation = config.simulator.config.sim.control_decimation_steps
+        finish_time = None
+        command_events = []
+        last_command = 0
+        try:
+            manager.start_walkrun()
+            while not remote.STOP.is_set() and time.monotonic() - start < args.duration:
+                elapsed = time.monotonic() - start
+                if elapsed > 2 and not started:
+                    if reference is not None:
+                        reference_start_q = data.qpos[bridge.qpos_adr].copy()
+                        reference_started_at = elapsed
+                        bridge.set_command_mode("user")
+                        manager.stop_walkrun()
+                        handoff_seen = True
+                    else:
+                        worker = threading.Thread(target=manager.start_action, args=("php_locomotion", "simulation"))
+                        worker.start()
+                    started = True
+                running = manager.action_running() if reference is None else started and not switched_back
+                if elapsed > 6 and running and not released:
+                    if not args.gantry:
+                        sim.virtual_gantry.set_enable(False)
+                        data.xfrc_applied[:] = 0
+                    write_command(args.forward_command)
+                    released = True
+                    print("[PHP simulation] forward command, gantry=" + str(args.gantry), flush=True)
+                if args.follow_course and released and running and not stopped_command:
+                    root_x, root_y = data.qpos[:2]
+                    quaternion = data.qpos[3:7]
+                    root_yaw = math.atan2(2 * (quaternion[0] * quaternion[3] + quaternion[1] * quaternion[2]),
+                                          1 - 2 * (quaternion[2] ** 2 + quaternion[3] ** 2))
+                    desired_yaw = math.atan2(-(root_y + 0.6 * data.qvel[1]), 1)
+                    heading_error = math.atan2(math.sin(desired_yaw - root_yaw), math.cos(desired_yaw - root_yaw))
+                    climbing = any(item["lower"][0] - 0.3 < root_x < item["upper"][0] + 0.15
+                                   and item["lower"][1] - 0.25 < root_y < item["upper"][1] + 0.25
+                                   for item in obstacles)
+                    command = args.forward_command
+                    if not climbing and abs(heading_error) > math.radians(22.5):
+                        if abs(heading_error) > math.radians(112.5):
+                            command = 11
+                        elif abs(heading_error) > math.radians(67.5):
+                            command = 3 if heading_error > 0 else 5
+                        else:
+                            command = 2 if heading_error > 0 else 4
+                        if args.forward_command == 6 and 1 <= command <= 5:
+                            command += 5
+                    if command != last_command:
+                        write_command(command)
+                        command_events.append({"time": elapsed, "command": command, "root": data.qpos[:3].tolist()})
+                        last_command = command
+                if args.finish_x > 0 and data.qpos[0] >= args.finish_x and finish_time is None:
+                    finish_time = elapsed
+                stop_at = finish_time if finish_time is not None else args.duration - 8
+                switch_at = finish_time + 4 if finish_time is not None else args.duration - 4
+                if elapsed > stop_at and running and not stopped_command:
+                    write_command(0)
+                    stopped_command = True
+                    print("[PHP simulation] stand before switch-back", flush=True)
+                if elapsed > switch_at and running and not switched_back:
+                    manager.stop_active(switch_mode="walkrun")
+                    switched_back = True
+                    print("[PHP simulation] switched back to walkrun", flush=True)
+                if args.stop_depth_at > 0 and elapsed > args.stop_depth_at and not depth_stopped:
+                    sim.installed_plugins["depth"].stop()
+                    depth_stopped = True
+                    print("[PHP simulation] depth producer stopped", flush=True)
+                result = manager.poll_action_done()
+                if result:
+                    exit_results.append(result)
+                handoff_seen = handoff_seen or manager.action_running()
+                bridge.publish_lowstate()
+                if args.stop_torso_imu_at <= 0 or elapsed < args.stop_torso_imu_at:
+                    torso_imu.quaternion = data.xquat[torso_id].tolist()
+                    torso_velocity = np.zeros(6)
+                    mujoco.mj_objectVelocity(model, data, mujoco.mjtObj.mjOBJ_BODY, torso_id, torso_velocity, 1)
+                    torso_imu.gyroscope = torso_velocity[:3].tolist()
+                    torso_publisher.Write(torso_imu)
+                if reference is not None and running and step % 10 == 0:
+                    state = np.zeros((1, 71))
+                    state[0, :7] = data.qpos[:7]
+                    state[0, 7:36] = data.qpos[bridge.qpos_adr]
+                    state[0, 39:42] = bridge.low_state.imu_state.gyroscope
+                    state[0, 42:71] = data.qvel[bridge.dof_adr]
+                    reference.interface = SimpleNamespace(get_low_state=lambda: state)
+                    reference._depth_sensor = SimpleNamespace(get_latest=lambda: sim.installed_plugins["depth"]._array.copy())
+                    reference.velocity_command[:] = 0
+                    reference.velocity_command[0, int(command_file.read_text())] = 1
+                    def capture_command(target, velocity, torque, latest, kp_override=None, kd_override=None):
+                        bridge.seq += 1
+                        bridge.usercmd = remote.SimLowCommand(
+                            target.copy(), velocity.copy(), torque.copy(),
+                            np.asarray(reference_config["robot"]["motor_kp"]),
+                            np.asarray(reference_config["robot"]["motor_kd"]),
+                            5, time.monotonic(), bridge.seq)
+                    reference.interface.send_low_command = capture_command
+                    if elapsed - reference_started_at < 1.5:
+                        blend = min(1, elapsed - reference_started_at)
+                        params = reference_config["robot"]
+                        target = reference_start_q * (1 - blend) + np.asarray(params["stiff_startup_pos"]) * blend
+                        capture_command(target, np.zeros(29), np.zeros(29), state[0, 7:36])
+                        bridge.usercmd.kp[:] = params["stiff_startup_kp"]
+                        bridge.usercmd.kd[:] = params["stiff_startup_kd"]
+                    else:
+                        BasePolicy.policy_action(reference)
+                if bridge.apply_command():
+                    if step % decimation == 0:
+                        sim.hooks.emit(Phase.FRAME_BEGIN)
+                    data.xfrc_applied[:] = 0
+                    sim.hooks.emit(Phase.PRE_STEP)
+                    sim.simulate_at_each_physics_step()
+                    sim.hooks.emit(Phase.POST_STEP)
+                    if step % decimation == 0:
+                        sim.hooks.emit(Phase.FRAME_END)
+                    step += 1
+                if step % 20 == 0:
+                    camera.lookat[:] = data.qpos[:3]
+                    renderer.update_scene(data, camera=camera)
+                    video.stdin.write(renderer.render().tobytes())
+                    ground_body_contacts = []
+                    obstacle_contacts = []
+                    for contact in data.contact:
+                        names = [mujoco.mj_id2name(model, mujoco.mjtObj.mjOBJ_GEOM, int(geom)) or "" for geom in (contact.geom1, contact.geom2)]
+                        body_names = [mujoco.mj_id2name(model, mujoco.mjtObj.mjOBJ_BODY, int(model.geom_bodyid[geom])) or "" for geom in (contact.geom1, contact.geom2)]
+                        if "floor" in names and contact.pos[2] < 0.05 and any(name in ("robot_pelvis", "robot_torso_link", "robot_head_link") for name in body_names):
+                            ground_body_contacts.extend(body_names)
+                        for obstacle in obstacles:
+                            if obstacle["geom_id"] in (contact.geom1, contact.geom2):
+                                obstacle_contacts.append({"obstacle": obstacle["name"], "bodies": body_names,
+                                                          "position": contact.pos.tolist()})
+                                if contact.pos[2] > obstacle["upper"][2] - 0.03 and any("ankle_roll" in name for name in body_names):
+                                    obstacle["foot_on_top"] = True
+                    for obstacle in obstacles:
+                        within_width = obstacle["lower"][1] <= data.qpos[1] <= obstacle["upper"][1]
+                        if within_width and obstacle["lower"][0] <= data.qpos[0] <= obstacle["upper"][0]:
+                            obstacle["entered"] = True
+                        if obstacle["entered"] and data.qpos[0] > obstacle["upper"][0] + 0.25:
+                            obstacle["exited"] = True
+                    telemetry.append({"wall_time": elapsed, "sim_time": data.time,
+                                      "root": data.qpos[:7].tolist(), "mode": bridge.mode,
+                                      "gantry": sim.virtual_gantry.enabled,
+                                      "tilt": remote.tilt_deg_from_quat_wxyz(data.qpos[3:7]),
+                                      "ground_body_contacts": ground_body_contacts,
+                                      "obstacle_contacts": obstacle_contacts})
+                    depth_plugin = sim.installed_plugins["depth"]
+                    if depth_plugin._array is not None:
+                        depth_records.append(depth_plugin._array[0, 0].copy())
+                    if not args.headless:
+                        sim.render()
+                    if len(telemetry) % 25 == 0:
+                        print("[PHP simulation] t=%.1f root=%s crossed=%d/%d" % (
+                            elapsed, np.round(data.qpos[:3], 3).tolist(),
+                            sum(item["entered"] and item["exited"] and item["foot_on_top"] for item in obstacles),
+                            len(obstacles)), flush=True)
+                    if data.qpos[2] < 0.35:
+                        print("[PHP simulation] fall detected; ending trial", flush=True)
+                        break
+                    if finish_time is not None and elapsed > finish_time + 8 and switched_back:
+                        break
+                next_step += 0.002
+                time.sleep(max(0, next_step - time.monotonic()))
+                if time.monotonic() - next_step > 0.02:
+                    next_step = time.monotonic()
+        finally:
+            if worker:
+                worker.join(timeout=12)
+            manager.shutdown()
+            renderer.close()
+            video.stdin.close()
+            video.wait()
+            (args.output / "telemetry.json").write_text(json.dumps(telemetry, indent=2))
+            np.savez_compressed(args.output / "depth.npz", depth=np.asarray(depth_records))
+            active = [item for item in telemetry if item["mode"] == "user"]
+            summary = {"engine": "official Python policy methods" if reference is not None else "ActionGo C++ generic_sensor_policy_player", "terrain": args.terrain,
+                       "depth_backend": args.depth_backend, "depth_hz": args.depth_hz,
+                       "depth_latency_frames": args.depth_latency_frames,
+                       "command_limit_source": "joint_position" if args.joint_position_limits else "pd_torque",
+                       "handoff_seen": handoff_seen, "scheduled_switch_back": switched_back,
+                       "policy_exits": exit_results, "gantry": args.gantry,
+                       "max_policy_tilt_deg": max((item["tilt"] for item in active), default=0),
+                       "final_root": telemetry[-1]["root"] if telemetry else [],
+                       "finish_x": args.finish_x, "finish_reached": finish_time is not None,
+                       "fell": any(item["root"][2] < 0.35 or item["ground_body_contacts"] for item in telemetry)}
+            summary["obstacles"] = obstacles
+            summary["crossed_obstacles"] = sum(item["entered"] and item["exited"] and item["foot_on_top"] for item in obstacles)
+            summary["finish_upright"] = bool(telemetry) and all(item["tilt"] < 20 and item["root"][2] > 0.5 for item in telemetry[-25:])
+            summary["course_passed"] = (bool(obstacles) and summary["crossed_obstacles"] == len(obstacles)
+                                        and not summary["fell"] and switched_back and summary["finish_upright"]
+                                        and handoff_seen and not args.gantry and not exit_results)
+            summary["command_events"] = command_events
+            (args.output / "summary.json").write_text(json.dumps(summary, indent=2))
+            print(json.dumps(summary), flush=True)
+            if not handoff_seen:
+                raise RuntimeError("PHP never completed the ready/start handoff")
+            if args.terrain == "terrain-load-step" and args.require_course_pass and not summary["course_passed"]:
+                raise RuntimeError("staircase acceptance failed; inspect summary.json and simulation.mp4")
+    print("[PHP simulation] saved " + str(args.output), flush=True)
+
+
+if __name__ == "__main__":
+    main()
