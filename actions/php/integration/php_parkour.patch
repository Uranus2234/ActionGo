+import argparse
+import json
+from pathlib import Path
+import subprocess
+
+import cv2
+import numpy as np
+from PIL import Image, ImageDraw
+
+
+def main():
+    parser = argparse.ArgumentParser()
+    parser.add_argument("output", type=Path)
+    args = parser.parse_args()
+    telemetry = json.loads((args.output / "telemetry.json").read_text())
+    depth = np.load(args.output / "depth.npz")["depth"]
+    capture = cv2.VideoCapture(str(args.output / "simulation.mp4"))
+    writer = subprocess.Popen([
+        "ffmpeg", "-y", "-loglevel", "error", "-f", "rawvideo", "-pix_fmt", "rgb24",
+        "-s", "960x540", "-r", "25", "-i", "-", "-an", "-c:v", "libx264",
+        "-preset", "fast", "-pix_fmt", "yuv420p", str(args.output / "simulation_depth.mp4"),
+    ], stdin=subprocess.PIPE)
+    count = 0
+    preview_frame = min(range(len(telemetry)), key=lambda frame_index: abs(telemetry[frame_index]["root"][0] - 14.9))
+    try:
+        while True:
+            present, frame = capture.read()
+            if not present:
+                break
+            frame = cv2.cvtColor(frame, cv2.COLOR_BGR2RGB)
+            index = min(count, len(depth) - 1)
+            panel = np.clip((depth[index] + 0.5) * 255, 0, 255).astype(np.uint8)
+            panel = np.repeat(np.repeat(panel, 3, axis=0), 3, axis=1)
+            frame[354:528, 687:948] = panel[..., None]
+            image = Image.fromarray(frame)
+            draw = ImageDraw.Draw(image)
+            root = telemetry[min(count, len(telemetry) - 1)]["root"]
+            draw.rectangle((8, 8, 490, 42), fill=(0, 0, 0))
+            draw.text((16, 18), "ActionGo C++ PHP | x=%.2f y=%.2f z=%.2f" % tuple(root[:3]), fill="white")
+            draw.rectangle((680, 327, 953, 352), fill=(0, 0, 0))
+            draw.text((687, 334), "Depth SHM 58x87: near dark / far light", fill="white")
+            writer.stdin.write(np.asarray(image).tobytes())
+            if count == preview_frame:
+                image.save(args.output / "depth_preview.png")
+            count += 1
+    finally:
+        capture.release()
+        writer.stdin.close()
+        status = writer.wait()
+        if status:
+            raise RuntimeError("video encoder failed")
+    print(args.output / "simulation_depth.mp4")
+
+
+if __name__ == "__main__":
+    main()
diff --git a/tools/check_php_hardware_parity.py b/tools/check_php_hardware_parity.py
new file mode 100644
--- /dev/null
+++ b/tools/check_php_hardware_parity.py
@@ -0,0 +1,96 @@
+#!/usr/bin/env python3
+import argparse
+import json
+from pathlib import Path
+import subprocess
+import tempfile
+from types import SimpleNamespace
+
+import numpy as np
+import yaml
+
+from holosoma.simulator.plugins.depth_shm_plugin import DepthShmPlugin
+
+
+def check_depth(root):
+    plugin = DepthShmPlugin.__new__(DepthShmPlugin)
+    plugin.cfg = SimpleNamespace(crop_top=2, crop_bottom=0, crop_left=4, crop_right=4,
+                                 resized_height=58, resized_width=87,
+                                 near_clip=0.3, far_clip=3.0, empty_threshold=0.15)
+    random = np.random.default_rng(42)
+    rows, columns = np.indices((60, 106))
+    cases = [np.full((60, 106), value, np.float32) for value in (0.0, 0.3, 1.2, 3.0, 20.0)]
+    cases += [np.where(columns < 53, 0.3, 3.0).astype(np.float32),
+              np.where((columns + rows) % 2, 0.3, 3.0).astype(np.float32),
+              (0.01 * rows + 0.02 * columns).astype(np.float32),
+              random.uniform(0.0, 5.0, (60, 106)).astype(np.float32)]
+    maximum = 0.0
+    with tempfile.TemporaryDirectory(prefix="php-depth-parity-") as temporary:
+        raw_path = Path(temporary) / "raw.f32"
+        processed_path = Path(temporary) / "processed.f32"
+        for raw in cases:
+            raw.tofile(raw_path)
+            subprocess.run([str(root / "build/depth_image_preprocess"), str(raw_path), str(processed_path)], check=True)
+            actual = np.fromfile(processed_path, np.float32).reshape(58, 87)
+            expected = plugin._resize_clip_normalize(raw)
+            maximum = max(maximum, float(np.max(np.abs(actual - expected))))
+    if maximum > 5e-6:
+        raise RuntimeError(f"C++ depth differs from official Torch preprocessing: {maximum}")
+    return {"cases": len(cases), "pixels_per_case": 58 * 87, "max_absolute_error": maximum}
+
+
+def check_commands(root, trace):
+    robot = yaml.safe_load((root / "actions/php/config/PHPParams.yaml").read_text())["robot"]
+    lower, upper = np.asarray(robot["joint_pos_lower_limit"]), np.asarray(robot["joint_pos_upper_limit"])
+    count, compensated, maximum = 0, 0, 0.0
+    with trace.open() as stream:
+        for line in stream:
+            record = yaml.load(line, Loader=getattr(yaml, "CSafeLoader", yaml.SafeLoader))
+            values = {key: np.asarray(value) for key, value in record.items()}
+            if not all(np.isfinite(value).all() for value in values.values()):
+                raise RuntimeError("nonfinite final LowCmd trace")
+            position, velocity = values["state_q"], values["state_dq"]
+            actual = values["kp"] * (values["q"] - position) - values["kd"] * velocity + values["tau"]
+            expected = np.clip(np.clip(values["requested_kp"], 0, 350) * (values["requested_q"] - position) - np.clip(values["requested_kd"], 0, 20) * velocity,
+                               -values["torque_limits"], values["torque_limits"])
+            maximum = max(maximum, float(np.max(np.abs(actual - expected))))
+            if np.any(values["q"] < lower - 1e-5) or np.any(values["q"] > upper + 1e-5):
+                raise RuntimeError("final LowCmd target exceeds physical joint limits")
+            if np.any(np.abs(values["tau"]) > values["torque_limits"] + 1e-3):
+                raise RuntimeError("final LowCmd feedforward exceeds torque limits")
+            compensated += int(np.max(np.abs(values["tau"])) > 1e-3)
+            count += 1
+    if not count or maximum > 1e-3:
+        raise RuntimeError(f"final LowCmd torque mismatch: samples={count}, max={maximum}")
+    return {"samples": count, "compensated_samples": compensated, "max_torque_error_nm": maximum,
+            "physical_target_limits_pass": True, "feedforward_limits_pass": True}
+
+
+def main():
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--actiongo-root", type=Path, default=Path(__file__).resolve().parents[2] / "action_go")
+    parser.add_argument("--lowcmd-trace", type=Path)
+    parser.add_argument("--output", type=Path)
+    args = parser.parse_args()
+    specs = [yaml.safe_load((args.actiongo_root / f"actions/php/config/generic_php{suffix}.yaml").read_text())
+             for suffix in ("", "_sim")]
+    for section in ("robot", "model", "observation", "startup", "handoff", "action", "safety"):
+        if specs[0][section] != specs[1][section]:
+            raise RuntimeError(f"hardware/simulation configuration differs in {section}")
+    for field in ("template", "variant", "inference_hz", "publish_hz", "onnx_threads"):
+        if specs[0]["runtime"][field] != specs[1]["runtime"][field]:
+            raise RuntimeError(f"hardware/simulation runtime differs in {field}")
+    for field in ("require_torso_imu", "disable_torso_imu", "torso_imu_timeout_sec"):
+        if specs[0]["sensor"][field] != specs[1]["sensor"][field]:
+            raise RuntimeError(f"hardware/simulation IMU configuration differs in {field}")
+    result = {"control_config_equal": True, "depth": check_depth(args.actiongo_root)}
+    if args.lowcmd_trace:
+        result["final_lowcmd"] = check_commands(args.actiongo_root, args.lowcmd_trace)
+    content = json.dumps(result, indent=2)
+    if args.output:
+        args.output.write_text(content + "\n")
+    print(content)
+
+
+if __name__ == "__main__":
+    main()
