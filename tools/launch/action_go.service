[Unit]
Description=action_go remote supervisor in tmux
Wants=network-online.target
After=network-online.target

[Service]
Type=forking
User=unitree
Group=unitree
WorkingDirectory=/home/unitree/action_go
Environment=HOME=/home/unitree
Environment=TERM=xterm-256color
Environment=ACTION_GO_TMUX_SESSION=action_go
Environment=ACTION_GO_TMUX_PID_FILE=/home/unitree/action_go/logs/action_go_tmux.pid
PIDFile=/home/unitree/action_go/logs/action_go_tmux.pid
# Set the robot DDS interface before enabling this service.
Environment=ACTION_GO_NET=eth0
ExecStart=/home/unitree/action_go/tools/launch/start.sh start
ExecStop=/home/unitree/action_go/tools/launch/start.sh stop
Restart=on-failure
RestartSec=2
TimeoutStartSec=30
TimeoutStopSec=20

[Install]
WantedBy=multi-user.target
