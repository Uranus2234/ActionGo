+++ b/tools/compare_actiongo_php.py
@@ -0,0 +1,109 @@
+#!/usr/bin/env python3
+import argparse
+from collections import deque
+import json
+from pathlib import Path
+from types import SimpleNamespace
+
+import numpy as np
+import onnxruntime as ort
+import yaml
+
+from holosoma_inference.policies.depth_distillation import DepthDistillationPolicy
+
+
+def official_policy(actiongo_root, config_path):
+    config = json.loads(config_path.read_text())
+    policy = DepthDistillationPolicy.__new__(DepthDistillationPolicy)
+    policy.config = SimpleNamespace(
+        observation=SimpleNamespace(**config["observation"]),
+        task=SimpleNamespace(debug=SimpleNamespace(**config["task"]["debug"]), print_observations=False),
+        camera=SimpleNamespace(props=SimpleNamespace(**config["camera"]["props"])),
+    )
+    policy.num_dofs = 29
+    policy.dof_names = config["robot"]["dof_names"]
+    policy.default_dof_angles = np.asarray(config["robot"]["default_dof_angles"])
+    policy._init_obs_config()
+    policy._init_waist_joint_indices()
+    policy._real2model_index = policy._model2real_index = None
+    policy.lin_vel_command = np.zeros((1, 2))
+    policy.ang_vel_command = np.zeros((1, 1))
+    policy.stand_command = np.zeros((1, 1))
+    policy._record_toggle_request = policy._recording = False
+    policy.velocity_command_dim = 15
+    policy.velocity_command = np.zeros((1, 15), dtype=np.float32)
+    policy.depth_buffer_len = 1
+    policy.depth_frame_buffer = deque(maxlen=3)
+    options = ort.SessionOptions()
+    options.intra_op_num_threads = 2
+    model_dir = actiongo_root / "actions/php/model"
+    policy.depth_backbone_session = ort.InferenceSession(str(model_dir / "depth_backbone.onnx"), options)
+    policy.depth_backbone_input_name = "depth_image"
+    policy.depth_backbone_output_name = "depth_latent"
+    actor = ort.InferenceSession(str(model_dir / "student.onnx"), options)
+    policy.onnx_input_names = ["obs", "time_step"]
+    policy.policy = lambda feed: actor.run(["actions"], feed)
+    policy.policy_action_scale = np.ones((1, 29), dtype=np.float32)
+    policy.last_policy_action = np.zeros((1, 29), dtype=np.float32)
+    return policy, config
+
+
+def main():
+    parser = argparse.ArgumentParser()
+    parser.add_argument("trace", type=Path)
+    parser.add_argument("--actiongo-root", type=Path, default=Path(__file__).resolve().parents[2] / "action_go")
+    parser.add_argument("--config", type=Path, default=Path(__file__).resolve().parents[1] / "outputs/php_official_inference_config.json")
+    parser.add_argument("--samples", type=int, default=100)
+    args = parser.parse_args()
+    policy, config = official_policy(args.actiongo_root, args.config)
+    robot = yaml.safe_load((args.actiongo_root / "actions/php/config/PHPParams.yaml").read_text())["robot"]
+    errors = {name: 0.0 for name in ("obs", "latent", "action", "target", "kp", "kd")}
+    for name in ("kp", "kd"):
+        errors[name] = float(np.max(np.abs(np.asarray(robot[name]) - config["robot"]["motor_" + name])))
+    count = 0
+    torso_frames = 0
+    waist_chain = policy._waist_joint_info
+    clipped_frames = 0
+    commands = set()
+    max_waist = 0.0
+    with args.trace.open() as trace:
+        for line in trace:
+            if count >= args.samples:
+                break
+            record = yaml.load(line, Loader=getattr(yaml, "CSafeLoader", yaml.SafeLoader))
+            state = np.zeros((1, 71), dtype=np.float64)
+            state[0, 3:7] = record["quat"]
+            state[0, 7:36] = record["q"]
+            state[0, 39:42] = record["gyro"]
+            state[0, 42:71] = record["dq"]
+            torso_frame = record.get("imu_source") == "torso"
+            policy._waist_joint_info = [] if torso_frame else waist_chain
+            torso_frames += int(torso_frame)
+            policy.last_policy_action = np.asarray(record["previous_action"], dtype=np.float32)[None]
+            policy.velocity_command[:] = 0
+            policy.velocity_command[0, record["command"]] = 1
+            depth = np.asarray(record["depth"], dtype=np.float32).reshape(1, 1, 58, 87)
+            policy._depth_sensor = SimpleNamespace(get_latest=lambda: depth)
+            feed = policy.prepare_obs_for_rl(state)
+            action = policy.rl_inference(state)[0]
+            target = policy.default_dof_angles + action
+            clipped_frames += int(np.max(np.abs(target - record["target"])) > 1e-4)
+            values = {"obs": feed["obs"][0], "latent": feed["obs"][0, -32:], "action": action, "target": target}
+            for name, value in values.items():
+                errors[name] = max(errors[name], float(np.max(np.abs(value - record[name]))))
+            commands.add(record["command"])
+            max_waist = max(max_waist, float(np.max(np.abs(state[0, 19:22]))))
+            count += 1
+    result = {"samples": count, "commands": sorted(commands), "max_waist_rad": max_waist,
+              "torso_snapshot_frames": torso_frames,
+              "torso_frame_adaptation": "skip waist chain for measured torso quaternion; retain pelvis angular velocity",
+              "target_changed_frames": clipped_frames,
+              "max_absolute_error": errors, "passed": count > 0 and max(errors.values()) <= 1e-4}
+    print(json.dumps(result, indent=2))
+    args.trace.with_name("comparison.json").write_text(json.dumps(result, indent=2))
+    if not result["passed"]:
+        raise SystemExit(1)
+
+
+if __name__ == "__main__":
+    main()
diff --git a/tools/php_depth_reference.py b/tools/php_depth_reference.py
new file mode 100644
--- /dev/null
+++ b/tools/php_depth_reference.py
@@ -0,0 +1,88 @@
+from pathlib import Path
+
+import mujoco
+import numpy as np
+import torch
+import trimesh
+
+from holosoma.sensors.warp.camera_config.d435i_depth_config import G1FlatRsD435iConfig
+from holosoma.sensors.warp.camera_sensor import CameraSensor
+from holosoma.sensors.warp.sensor_utils import quat_mul_xyzw, tf_apply_xyzw
+
+
+class TrainingDepthCamera:
+    def __init__(self, model, data):
+        import holosoma
+
+        self.model, self.data = model, data
+        config = G1FlatRsD435iConfig()
+        config.randomize_placement = False
+        terrain_path = Path(holosoma.__file__).parent / "data/terrains/terrain.obj"
+        self.sensor = CameraSensor(1, config, trimesh.load_mesh(terrain_path), device="cuda:0")
+        self.body_ids = [mujoco.mj_name2id(model, mujoco.mjtObj.mjOBJ_BODY, "robot_" + name)
+                         for name in self.sensor.ray_cast_bodies]
+        self.torso_id = mujoco.mj_name2id(model, mujoco.mjtObj.mjOBJ_BODY, "robot_torso_link")
+        if min(self.body_ids + [self.torso_id]) < 0:
+            raise ValueError("training depth body missing from MuJoCo model")
+
+    def capture(self):
+        sensor = self.sensor
+        sensor.ray_cast_body_poses_tensor[:] = torch.as_tensor(self.data.xpos[self.body_ids], device=sensor.device)[None]
+        sensor.ray_cast_body_quats_tensor[:] = torch.as_tensor(self.data.xquat[self.body_ids][:, [1, 2, 3, 0]], device=sensor.device)[None]
+        position = torch.as_tensor(self.data.xpos[self.torso_id], dtype=torch.float32, device=sensor.device)[None, None]
+        quaternion = torch.as_tensor(self.data.xquat[self.torso_id][[1, 2, 3, 0]], dtype=torch.float32, device=sensor.device)[None, None]
+        sensor.camera_sensor_position[:] = tf_apply_xyzw(quaternion, position, sensor.camera_sensor_local_position)
+        sensor.camera_sensor_orientation[:] = quat_mul_xyzw(
+            quaternion, quat_mul_xyzw(sensor.camera_sensor_local_orientation, sensor.camera_sensor_data_frame_quat))
+        return sensor.capture()[0, 0].cpu().numpy().copy()
+
+
+def install_training_depth(sim):
+    plugin = sim.installed_plugins["depth"]
+    plugin.stop()
+    camera = TrainingDepthCamera(sim.root_model, sim.root_data)
+    camera.capture()
+    original = sim.backend.render_cameras
+
+    def render(cameras):
+        for runtime in cameras:
+            if runtime.name == plugin.cfg.camera:
+                frame = camera.capture()
+                runtime.set_buffer("depth", torch.from_numpy(frame)[None, ..., None])
+            else:
+                original([runtime])
+
+    sim.backend.render_cameras = render
+    plugin.start()
+    return camera
+
+
+def compare_depth(sim, output):
+    import json
+
+    plugin = sim.installed_plugins["depth"]
+    plugin.stop()
+    camera = TrainingDepthCamera(sim.root_model, sim.root_data)
+    initial_qpos = sim.root_data.qpos.copy()
+    frames, results = [], []
+    runtime = sim.sensor_manager.get(plugin.cfg.camera)
+    for root_x in (0, 2.5, 3.7, 4.2, 5.0, 13.8, 14.2):
+        sim.root_data.qpos[:] = initial_qpos
+        sim.root_data.qpos[0] = root_x
+        mujoco.mj_forward(sim.root_model, sim.root_data)
+        sim.backend.render_cameras([runtime])
+        rendered = sim.get_camera_data(plugin.cfg.camera, "depth", device="cpu")[0, ..., 0].numpy()
+        training = camera.capture()
+        rendered = np.clip(rendered, plugin.cfg.near_clip, plugin.cfg.far_clip)
+        training = np.clip(training, plugin.cfg.near_clip, plugin.cfg.far_clip)
+        processed = [plugin._resize_clip_normalize(frame) for frame in (rendered, training)]
+        difference = np.abs(processed[0] - processed[1])
+        results.append({"root_x": root_x, "mean_absolute_error": float(difference.mean()),
+                        "p95_absolute_error": float(np.percentile(difference, 95)),
+                        "fraction_over_0_05": float(np.mean(difference > 0.05))})
+        frames.append(np.stack(processed))
+    np.savez_compressed(output / "depth_geometry.npz", frames=np.asarray(frames))
+    (output / "depth_geometry.json").write_text(json.dumps(results, indent=2))
+    sim.root_data.qpos[:] = initial_qpos
+    mujoco.mj_forward(sim.root_model, sim.root_data)
+    print(json.dumps(results), flush=True)
