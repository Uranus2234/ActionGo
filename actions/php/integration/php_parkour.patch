+#!/usr/bin/env bash
+set -euo pipefail
+PHP_ROOT=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
+source "$PHP_ROOT/.env.local"
+export LD_LIBRARY_PATH="${PHP_SIM_LIBRARY_PATH}${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
+export MUJOCO_GL=${MUJOCO_GL:-glfw}
+cd "$PHP_ROOT/thirdparty/holosoma"
+exec "$PHP_SIM_PYTHON" "$PHP_ROOT/tools/actiongo_mujoco.py" "$@"
